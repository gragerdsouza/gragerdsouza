{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gragerdsouza/portfolio",
    "type": "project",
    "description": "Grager D'souza — personal portfolio. Laravel 13, Filament admin, 100% test coverage, CI/CD to Laravel Cloud.",
    "keywords": [
        "portfolio",
        "laravel",
        "filament",
        "pest",
        "tdd",
        "devops"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.11",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.23",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.27",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest --parallel --coverage --min=100"
        ],
        "test:arch": "@php vendor/bin/pest --testsuite=Arch",
        "lint": "@php vendor/bin/pint --test",
        "lint:fix": "@php vendor/bin/pint",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "@php vendor/bin/rector process --dry-run",
        "refactor:fix": "@php vendor/bin/rector process",
        "ci": [
            "@lint",
            "@refactor",
            "@analyse",
            "@test:coverage"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Grager D'souza",
            "email": "gragerdsouza@gmail.com",
            "role": "Developer"
        }
    ],
    "scripts-descriptions": {
        "test": "Run the Pest suite in parallel (arch, unit, feature).",
        "test:coverage": "Run Pest with coverage; fails below 100%.",
        "test:arch": "Run architecture tests only.",
        "lint": "Check code style with Pint.",
        "lint:fix": "Fix code style with Pint.",
        "analyse": "Static analysis with Larastan (max level).",
        "refactor": "Preview Rector refactors.",
        "refactor:fix": "Apply Rector refactors.",
        "ci": "Run every quality gate CI runs."
    }
}
